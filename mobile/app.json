{
  "expo": {
    "name": "SAHAL SHOP",
    "slug": "sahalshop",
    "owner": "cherifcoder",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sahalshop",
    "userInterfaceStyle": "light",
    "description": "Point de vente et gestion de boutique SAHAL SHOP.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sahalshop.app"
    },
    "android": {
      "package": "com.sahalshop.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser SAHAL SHOP à accéder à vos photos pour illustrer les articles.",
          "cameraPermission": "Autoriser SAHAL SHOP à utiliser l'appareil photo pour illustrer les articles."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8ea3a6ee-f299-42aa-b9ab-486db14b4314"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8ea3a6ee-f299-42aa-b9ab-486db14b4314"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
